---
import Layout from "../../layouts/Layout.astro";
import Motion from "../../components/Motion";
import { cases } from "../../data/case-studies";
import { projects } from "../../data/resume";
export function getStaticPaths() {
  return Object.entries(cases).map(([slug, study]) => ({
    params: { slug },
    props: { study, project: projects.find((p) => p.id === slug)! },
  }));
}
const { study, project } = Astro.props;
---

<Layout
  title={`${study.title} — Engineering case study | Usman Khan`}
  description={study.problem}
>
  <div class="shell">
    <header class="case-header">
      <a class="back-link" href="/#projects">← All projects</a><p
        class="eyebrow"
      >
        {study.eyebrow}
      </p><h1>{study.title}</h1><p class="case-lead">{study.problem}</p><div
        class="case-meta"
      >
        <span>{study.role}</span><span>{study.context}</span>
      </div><div class="project-actions">
        <a href={project.repository}>Source code ↗</a>{
          "demo" in project && <a href={project.demo}>{project.demoLabel} ↗</a>
        }
      </div>
    </header>
    <div class="case-media">
      <Motion
        {...project}
        caption={project.id === "moneo"
          ? "Illustrated workflow · fictional financial data · not a product recording"
          : undefined}
      />
    </div>
    <section class="case-section">
      <p class="eyebrow">The problem & approach</p><h2>
        Built around the workflow.
      </h2><p>{study.introduction}</p><div class="journey">
        {
          study.journey.map(([title, text], i) => (
            <article>
              <>
                <span>STEP {i + 1}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    {
      project.id !== "nox" && (
        <section class="case-section">
          <>
            <p class="eyebrow">From the live app</p>
            <h2>
              {project.id === "unipirate"
                ? "The public starting point."
                : "A private workspace starts with sign-in."}
            </h2>
            <figure class="live-capture">
              <>
                <img
                  src={`/portfolio-media/screenshots/${project.id === "unipirate" ? "unipirate-live" : "moneo-login"}.webp`}
                  alt={
                    project.id === "unipirate"
                      ? "Actual UniPirate public checker landing page"
                      : "Actual Moneo email sign-in screen, with no private records"
                  }
                  width="1280"
                  height="853"
                  loading="lazy"
                />
                <figcaption>
                  Actual public website · captured October 10, 2026
                  {project.id === "moneo" &&
                    " · authenticated screens were not accessed"}
                </figcaption>
              </>
            </figure>
          </>
        </section>
      )
    }
    <section class="case-section">
      <p class="eyebrow">Under the hood</p><h2>How the pieces connect.</h2><p>
        {study.flow}
      </p><ol
        class="architecture"
        aria-label={`${study.title} system architecture`}
      >
        {
          study.architecture.map(([title, text, path]) => (
            <li>
              <>
                <h3>{title}</h3>
                <p>{text}</p>
                <code>{path}</code>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    <section class="case-section">
      <p class="eyebrow">Engineering decisions</p><h2>
        The trade-offs that matter.
      </h2><div class="choice-list">
        {
          study.choices.map(([title, text]) => (
            <article>
              <>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="case-section">
      <p class="eyebrow">Evidence & boundaries</p><h2>
        What is tested. What is still open.
      </h2><p>{study.testing}</p><ul class="case-evidence">
        {
          study.evidence.map(([label, href]) => (
            <li>
              <a href={href}>{label} ↗</a>
            </li>
          ))
        }
      </ul><div class="limitation">
        <h3>Known limitations</h3><p>{study.limitations}</p>
      </div>
    </section>
    <section class="case-section">
      <p class="eyebrow">Looking ahead</p><h2>What I'd improve next.</h2><p>
        {study.next}
      </p>
    </section>
    <nav class="next-case" aria-label="Other projects">
      <a href="/#projects">← Back to selected work</a><a
        href={`/projects/${study.nextId}`}>Next: {study.nextTitle} ↗</a
      >
    </nav>
  </div>
</Layout>
